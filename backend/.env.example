# Port du serveur Express
PORT=5000

# Environnement d'exécution
NODE_ENV=development

# Connexion MongoDB - base de données : agrismart (instance standalone sur 27021)
# Si le serveur local est un replica set dont les autres membres sont arrêtés,
# ajouter ?directConnection=true pour se connecter directement au noeud actif.
MONGO_URI=mongodb://127.0.0.1:27021/agrismart

# JWT : remplacer par une clé longue et aléatoire en production
JWT_SECRET=remplacez_par_une_cle_longue_et_aleatoire
JWT_EXPIRES_IN=7d

# Origine autorisée par CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173
