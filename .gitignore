# ============================================================
# AgriSmart - .gitignore
# ============================================================

# Dépendances
node_modules/
**/node_modules/

# Variables d'environnement (aucun secret ne doit être versionné)
.env
**/.env
.env.*
**/.env.*
!**/.env.example

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Builds et caches
dist/
**/dist/
build/
**/build/
.vite/
coverage/
**/coverage/
*.tsbuildinfo

# Éditeurs et système
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Fichiers temporaires
*.tmp
*.bak
*.orig
*.rej
